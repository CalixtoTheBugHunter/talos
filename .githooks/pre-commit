#!/usr/bin/env bash
#
# Runs SwiftFormat then SwiftLint over the staged Swift files, plus design-guard
# over the repository and a gitleaks secret scan over the staged diff, so a
# style, correctness, no-values, or secret-shaped-literal failure surfaces here
# instead of in CI — or instead of reaching git at all.
#
# The tools, the order, and the fact that a hook exists at all are SPEC
# decisions, and the reasoning is on the wiki rather than repeated here:
#
#   https://github.com/CalixtoTheBugHunter/talos/wiki/Engineering-Standards#toolchain
#
# Installation is opt-in, per clone, and one command — see CONTRIBUTING.md.
# This hook is not a substitute for the `lint` CI stage: CI is the required
# check, and a contributor who has not installed the hook is not doing anything
# wrong.

set -euo pipefail

fail() {
  printf 'pre-commit: %s\n' "$1" >&2
  exit 1
}

require() { # require <tool> <brew formula>
  command -v "$1" >/dev/null 2>&1 || fail "$1 is not installed. brew install $2"
}

# The half of the no-values rule SwiftLint cannot see, per decision 56 —
# https://github.com/CalixtoTheBugHunter/talos/wiki/Decision-Log#engineering-decisions
#
# It runs first and unconditionally, because one of the two classes it owns is a
# bundled color asset, which is not a Swift file: a commit staging only a
# `.colorset` would otherwise exit below without it. Like the `lint` stage, it
# scans the repository's tracked files rather than this commit's diff, so it can
# report a violation this commit did not introduce — that identical surface is
# what makes the local answer and CI's the same one.
#
# Silent when it passes. Its output is the failure message, not a status line.
guard_output=''
if ! guard_output="$(tools/design-guard/design-guard.sh 2>&1)"; then
  printf '%s\n' "$guard_output" >&2
  fail 'design-guard found violations of the no-values rule. What it does not cover is in tools/design-guard/README.md'
fi

# Also unconditional, and also before the Swift-only early exit below: a
# secret staged in YAML, JSON, or Markdown is still this commit's content, and
# the same committed .gitleaks.toml the CI scan reads is what decides here too
# — https://github.com/CalixtoTheBugHunter/talos/issues/29. See the `require`
# precedent applied to swiftformat/swiftlint below; this is that same pattern
# applied to gitleaks, run earlier because the tool it needs is not Swift-only.
require gitleaks gitleaks

secret_scan_output=''
if ! secret_scan_output="$(tools/secret-scan/secret-scan.sh protect-staged 2>&1)"; then
  printf '%s\n' "$secret_scan_output" >&2
  fail 'secret-scan found a secret-shaped literal staged for commit. See tools/secret-scan/README.md and SECURITY.md if this is real.'
fi

# Staged Swift files, NUL-separated so a path with a space survives.
staged=()
while IFS= read -r -d '' path; do
  staged+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.swift')

[ ${#staged[@]} -gt 0 ] || exit 0

require swiftformat swiftformat
require swiftlint swiftlint

# A file staged in part — `git add -p`, or edited after staging — has content in
# the index that differs from the worktree. Formatting it would stage an edit
# nobody read, and re-staging it would swallow the unstaged half into this
# commit. So those files are linted rather than fixed, and named.
unstaged=()
while IFS= read -r -d '' path; do
  unstaged+=("$path")
done < <(git diff --name-only -z -- '*.swift')

autofixable=()
partial=()
for path in "${staged[@]}"; do
  is_partial=0
  for dirty in ${unstaged[@]+"${unstaged[@]}"}; do
    [ "$path" = "$dirty" ] && is_partial=1 && break
  done
  if [ "$is_partial" -eq 1 ]; then partial+=("$path"); else autofixable+=("$path"); fi
done

# Autofix the wholly-staged files, then re-stage exactly those SwiftFormat
# changed. § Toolchain: "developers autofix locally".
if [ ${#autofixable[@]} -gt 0 ]; then
  swiftformat "${autofixable[@]}" --quiet
  for path in "${autofixable[@]}"; do
    if ! git diff --quiet -- "$path"; then
      git add -- "$path"
      printf 'pre-commit: formatted and re-staged %s\n' "$path"
    fi
  done
fi

if [ ${#partial[@]} -gt 0 ]; then
  if ! swiftformat --lint "${partial[@]}" --quiet; then
    printf 'pre-commit: the files above are staged in part, so they were not\n' >&2
    printf '            formatted — a fix would stage an edit you have not read.\n' >&2
    fail "run: swiftformat ${partial[*]}"
  fi
fi

# `--force-exclude` so a path named explicitly is still skipped when
# `.swiftlint.yml` excludes it. Warnings-as-errors comes from `strict: true`
# there, not from a flag here.
swiftlint lint --quiet --force-exclude --no-cache "${staged[@]}" \
  || fail 'SwiftLint found violations. Fix them, or run: swiftlint lint --fix'
